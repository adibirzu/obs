ily=Arial;fontSize=14;fontColor=#182230;fillColor=#FFFFFF;strokeColor=#6A3D9A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="378" y="2007.2380952380952" width="308" height="22.952380952380953" as="geometry"/></mxCell><mxCell id="iam-governance-v-97" value="• Required Logging" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Arial;fontSize=14;fontColor=#182230;fillColor=#FFFFFF;strokeColor=#6A3D9A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="64" y="2036.1904761904761" width="308" height="22.952380952380953" as="geometry"/></mxCell><mxCell id="iam-governance-v-98" value="• Required Alarms" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Arial;fontSize=14;fontColor=#182230;fillColor=#FFFFFF;strokeColor=#6A3D9A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="378" y="2036.1904761904761" width="308" height="22.952380952380953" as="geometry"/></mxCell><mxCell id="iam-governance-v-99" value="• Baseline Budgets" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Arial;fontSize=14;fontColor=#182230;fillColor=#FFFFFF;strokeColor=#6A3D9A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="64" y="2065.142857142857" width="308" height="22.952380952380953" as="geometry"/></mxCell><mxCell id="iam-governance-v-100" value="• Quota Controls" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Arial;fontSize=14;fontColor=#182230;fillColor=#FFFFFF;strokeColor=#6A3D9A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="378" y="2065.142857142857" width="308" height="22.952380952380953" as="geometry"/></mxCell><mxCell id="iam-governance-v-101" value="• Security Baselines" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Arial;fontSize=14;fontColor=#182230;fillColor=#FFFFFF;strokeColor=#6A3D9A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="64" y="2094.095238095238" width="308" height="22.952380952380953" as="geometry"/></mxCell><mxCell id="iam-governance-v-102" value="• Landing Zone Drift" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Arial;fontSize=14;fontColor=#182230;fillColor=#FFFFFF;strokeColor=#6A3D9A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="378" y="2094.095238095238" width="308" height="22.952380952380953" as="geometry"/></mxCell><mxCell id="iam-governance-v-103" value="• Operational Readiness" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Arial;fontSize=14;fontColor=#182230;fillColor=#FFFFFF;strokeColor=#6A3D9A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="64" y="2123.047619047619" width="308" height="22.952380952380953" as="geometry"/></mxCell><mxCell id="iam-governance-v-104" value="• Policy Validation" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontFamily=Arial;fontSize=14;fontColor=#182230;fillColor=#FFFFFF;strokeColor=#6A3D9A;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="378" y="2123.047619047619" width="308" height="22.952380952380953" as="geometry"/></mxCell><mxCell id="iam-governance-v-105" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=42;spacingLeft=16;spacingRight=14;fontFamily=Arial;fontSize=15;fontColor=#182230;fillColor=#EEF6FF;strokeColor=#8CB7E8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="480" width="640" height="552" as="geometry"/></mxCell><mxCell id="iam-governance-v-106" value="A. CORE OBSERVABILITY" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontStyle=1;fontSize=17;fontColor=#145CA8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="894" y="488" width="612" height="34" as="geometry"/></mxCell><mxCell id="iam-governance-v-107" value="OCI Monitoring&amp;#xa;Collects service and custom metrics, evaluates MQL queries, and provides the metric foundation for health and capacity views." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="528" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-108" value="OCI Logging&amp;#xa;Centralizes service logs, custom application logs, and audit records in searchable log groups with controlled retention." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="612.1666666666666" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-109" value="OCI Events&amp;#xa;Detects resource lifecycle and state changes and routes matching events to notification or automation targets." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="696.3333333333334" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-110" value="OCI Alarms&amp;#xa;Evaluates metric streams against MQL thresholds and emits stateful, severity-aware operational alarm messages." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="780.5" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-111" value="OCI Notifications&amp;#xa;Publishes messages through topics and subscriptions to people, HTTPS endpoints, functions, and supported delivery channels." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="864.6666666666667" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-112" value="OCI Announcements&amp;#xa;Provides tenancy-scoped information about service events, planned maintenance, advisories, and operational notices." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="948.8333333333334" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-113" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=42;spacingLeft=16;spacingRight=14;fontFamily=Arial;fontSize=15;fontColor=#182230;fillColor=#EEF6FF;strokeColor=#8CB7E8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="1044" width="640" height="552" as="geometry"/></mxCell><mxCell id="iam-governance-v-114" value="B. ADVANCED ANALYTICS" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontStyle=1;fontSize=17;fontColor=#145CA8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="894" y="1052" width="612" height="34" as="geometry"/></mxCell><mxCell id="iam-governance-v-115" value="OCI Logging Analytics&amp;#xa;Indexes and enriches logs for interactive search, clustering, link analysis, anomaly detection, and root-cause investigation." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1092" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-116" value="OCI Application Performance Monitoring&amp;#xa;Correlates distributed traces, application topology, synthetic monitoring, and real-user experience for service transactions." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1176.1666666666667" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-117" value="OCI Stack Monitoring&amp;#xa;Discovers and monitors application-stack resources, their health, performance, and topology relationships across infrastructure layers." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1260.3333333333333" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-118" value="OCI Ops Insights&amp;#xa;Analyzes long-term database and host utilization, SQL behavior, capacity trends, and enterprise-wide performance history." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1344.5" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-119" value="Resource Analytics&amp;#xa;Provides near-real-time inventory, relationship, and configuration metadata through SQL, property graphs, and analytics dashboards." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1428.6666666666667" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-120" value="OCI Database Management&amp;#xa;Provides fleet health, performance diagnostics, SQL monitoring, configuration visibility, and management for Oracle databases." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1512.8333333333335" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="iam-governance-v-121" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=42;spacingLeft=16;spacingRight=14;fontFamily=Arial;fontSize=15;fontColor=#182230;fillColor=#EEF6FF;strokeColor=#8CB7E8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="1608" width="640" height="552" as="geometry"/></mxCell><mxCell id="iam-governance-v-122" value="C. GOVERNANCE AND OPTIMIZATION" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontStyle=1;fontSize=17;fontColor=#145CA8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="894" y="1616" width="612" height="34" as="geometry"/></mxCell><mxCell id="iam-governance-v-123" value="Cloud Advisor&amp;#xa;Produces prioritized recommendations for cost, security, availability, performance, and operational improvement across OCI resources." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1656" width="612" height="84" as="geometry"/></mxCell><mxCell id="iam-governance-v-124" value="Cost Analysis&amp;#xa;Analyzes OCI spending by service, compartment, tag, subscription, and time period for allocation and optimization decisions." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1747" width="612" height="84" as="geometry"/></mxCell><mxCell id="iam-governance-v-125" value="Limits, Quotas, and Budgets&amp;#xa;Tracks service limits and consumption controls, compartment quotas, budget thresholds, and forecasted spend pressure." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1838" width="612" height="84" as="geometry"/></mxCell><mxCell id="iam-governance-v-126" value="Tenancy Explorer&amp;#xa;Provides inventory-oriented discovery of resources across compartments and tenancies to support visibility and governance reviews." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1929" width="61