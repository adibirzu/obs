<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" type="device"><diagram id="network-firewall-waf" name="Network Firewall and WAF security events"><mxGraphModel dx="1400" dy="1060" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="1060"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="NETWORK INTERLOCK · Network Firewall and WAF security events" style="html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;fontColor=#102A43;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="55" width="1260" height="46" as="geometry"/></mxCell><mxCell id="trigger" value="Trigger · A security policy blocks suspicious or legitimate traffic." style="html=1;strokeColor=none;fillColor=none;fontSize=15;fontColor=#52616B;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="118" width="1260" height="48" as="geometry"/></mxCell><mxCell id="sources" value="&lt;b&gt;SOURCE EVIDENCE&lt;/b&gt;&lt;br&gt;&lt;br&gt;• OCI Network Firewall&lt;br&gt;• Web Application Firewall&lt;br&gt;• Security Lists" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#C79200;fillColor=#FFFFFF;fontColor=#102A43;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="290" width="380" height="210" as="geometry"/></mxCell><mxCell id="services" value="&lt;b&gt;OBSERVABILITY HANDOFF&lt;/b&gt;&lt;br&gt;&lt;br&gt;• OCI Logging&lt;br&gt;• Oracle Log Analytics (Logan)&lt;br&gt;• OCI Events" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#145CA8;fillColor=#FFFFFF;fontColor=#102A43;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="510" y="290" width="380" height="210" as="geometry"/></mxCell><mxCell id="outcome" value="&lt;b&gt;OPERATIONAL OUTCOME&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Triage a security finding with the matching network evidence." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#256D3F;fillColor=#FFFFFF;fontColor=#102A43;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="950" y="290" width="380" height="210" as="geometry"/></mxCell><mxCell id="source-to-services" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#145CA8;" edge="1" parent="1" source="sources" target="services"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="services-to-outcome" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#145CA8;" edge="1" parent="1" source="services" target="outcome"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="steps" value="&lt;b&gt;GUIDED RESPONSE&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Collect firewall and WAF events&lt;br&gt;&lt;br&gt;2. Cluster rules, targets, and patterns&lt;br&gt;&lt;br&gt;3. Correlate with affected applications&lt;br&gt;&lt;br&gt;4. Create a governed response workflow" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#102A43;fillColor=#FFFFFF;fontColor=#102A43;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="70" y="555" width="1260" height="240" as="geometry"/></mxCell><mxCell id="prerequisites" value="&lt;b&gt;SYSTEM PREREQUISITES&lt;/b&gt;&lt;br&gt;&lt;br&gt;• OCI IAM read access is scoped to the intended tenancy, compartments, and telemetry resources.&lt;br&gt;• Signal collection, retention, clocks, and the investigation time window are validated before querying.&lt;br&gt;• Resource ownership and escalation routes are mapped before an operational action is assigned.&lt;br&gt;• Required log sources, parsers, entities, and log groups are enabled in Logan." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#52616B;fillColor=#FFFFFF;fontColor=#102A43;align=left;verticalAlign=top;spacing=18;fontSize=14;" vertex="1" parent="1"><mxGeometry x="70" y="815" width="610" height="210" as="geometry"/></mxCell><mxCell id="correlation" value="&lt;b&gt;DISTRIBUTED CORRELATION KEYS&lt;/b&gt;&lt;br&gt;&lt;br&gt;trace_id · service.name · resource_or_entity_id · event_time_utc · tenant_key · source.ip · destination.ip · source.port · destination.port · network.protocol" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#145CA8;fillColor=#FFFFFF;fontColor=#102A43;align=left;verticalAlign=top;spacing=18;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="815" width="630" height="100" as="geometry"/></mxCell><mxCell id="empty-result" value="&lt;b&gt;EMPTY-RESULT CAVEAT&lt;/b&gt;&lt;br&gt;&lt;br&gt;An empty result is inconclusive and does not prove absence. Confirm permissions, tenancy and compartment scope, region, collection health, parser and field mappings, and the time window before widening or simplifying the query." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#C79200;fillColor=#FFFDF5;fontColor=#102A43;align=left;verticalAlign=top;spacing=18;fontSize=14;" vertex="1" parent="1"><mxGeometry x="700" y="935" width="630" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>