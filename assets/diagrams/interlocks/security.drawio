rap;html=1;align=left;verticalAlign=top;spacingTop=42;spacingLeft=16;spacingRight=14;fontFamily=Arial;fontSize=15;fontColor=#182230;fillColor=#EEF6FF;strokeColor=#8CB7E8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="1044" width="640" height="552" as="geometry"/></mxCell><mxCell id="security-v-103" value="B. ADVANCED ANALYTICS" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontStyle=1;fontSize=17;fontColor=#145CA8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="894" y="1052" width="612" height="34" as="geometry"/></mxCell><mxCell id="security-v-104" value="OCI Logging Analytics&amp;#xa;Indexes and enriches logs for interactive search, clustering, link analysis, anomaly detection, and root-cause investigation." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1092" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="security-v-105" value="OCI Application Performance Monitoring&amp;#xa;Correlates distributed traces, application topology, synthetic monitoring, and real-user experience for service transactions." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1176.1666666666667" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="security-v-106" value="OCI Stack Monitoring&amp;#xa;Discovers and monitors application-stack resources, their health, performance, and topology relationships across infrastructure layers." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1260.3333333333333" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="security-v-107" value="OCI Ops Insights&amp;#xa;Analyzes long-term database and host utilization, SQL behavior, capacity trends, and enterprise-wide performance history." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1344.5" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="security-v-108" value="Resource Analytics&amp;#xa;Provides near-real-time inventory, relationship, and configuration metadata through SQL, property graphs, and analytics dashboards." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1428.6666666666667" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="security-v-109" value="OCI Database Management&amp;#xa;Provides fleet health, performance diagnostics, SQL monitoring, configuration visibility, and management for Oracle databases." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1512.8333333333335" width="612" height="77.16666666666667" as="geometry"/></mxCell><mxCell id="security-v-110" value="" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingTop=42;spacingLeft=16;spacingRight=14;fontFamily=Arial;fontSize=15;fontColor=#182230;fillColor=#EEF6FF;strokeColor=#8CB7E8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="880" y="1608" width="640" height="552" as="geometry"/></mxCell><mxCell id="security-v-111" value="C. GOVERNANCE AND OPTIMIZATION" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontStyle=1;fontSize=17;fontColor=#145CA8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="894" y="1616" width="612" height="34" as="geometry"/></mxCell><mxCell id="security-v-112" value="Cloud Advisor&amp;#xa;Produces prioritized recommendations for cost, security, availability, performance, and operational improvement across OCI resources." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1656" width="612" height="84" as="geometry"/></mxCell><mxCell id="security-v-113" value="Cost Analysis&amp;#xa;Analyzes OCI spending by service, compartment, tag, subscription, and time period for allocation and optimization decisions." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="894" y="1747" width="612" height="84" as="geometry"/></mxCell><mxCell id="security-v-114" value="Limits, Quotas, and Budgets&amp;#xa;Tracks service limits and consumption controls, compartment quotas, budget thresholds, and forecasted spend pressure." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=12;fontFamily=Arial;fontStyle=1;fontSize=15;fontColor=#102A43;fillColor=#FFFFFF;strokeColor=#8CB7E8;strokeWidth=1.4;" vertex="1" parent="1"><mxGeometry x="