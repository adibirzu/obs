{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adibirzu.github.io/obs/schemas/community-scenario.schema.json",
  "title": "OCTO Observability Atlas community scenario",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "summary", "status", "ownership", "discovery", "topology", "telemetry", "failurePoints", "workflow", "references"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 20 },
    "summary": { "type": "string", "minLength": 80 },
    "status": { "enum": ["proposal", "reference", "deprecated"] },
    "ownership": {
      "type": "object",
      "required": ["communityAuthor", "projectMaintainer", "serviceOwners"]
    },
    "discovery": {
      "type": "object",
      "required": ["queryTerms", "personas", "industries", "goals", "finderPatterns", "interlocks"]
    },
    "topology": {
      "type": "object",
      "required": ["businessService", "serviceLevelObjective", "environments", "route"]
    },
    "telemetry": {
      "type": "object",
      "required": ["metrics", "logs", "traces", "boundaries"]
    },
    "failurePoints": { "type": "array", "minItems": 3 },
    "workflow": {
      "type": "object",
      "required": ["prerequisites", "correlationKeys", "steps", "emptyResult"]
    },
    "references": { "type": "array", "minItems": 1 }
  },
  "additionalProperties": false
}
